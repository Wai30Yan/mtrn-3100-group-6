%% 
syms txf tyf ttf
% Redundant states
syms vxf vyf vtf

% l is the distance between the IMU and center of rotation
syms dt rd bw

txi = txf - vxf*dt;
tyi = tyf - vyf*dt;
tti = ttf - vtf*dt - atf*dt^2/2;

% Average values to mix in the acceleration more
vxa = (vxi + vxf) / 2;
vya = (vyi + vyf) / 2;
vta = (vti + vtf) / 2;
tta = (tti + ttf) / 2;

% Velocity and acceleration in the robot FoR
vg = rot2(-tta)*[vxa; vya];
ag = rot2(-tta)*[axf; ayf];

% Encoder velocities
dwl = 1/rd * (2*vg(1) - bw*vta) * dt;
dwr = 1/rd * (2*vg(1) + bw*vta) * dt;
% Forced to zero to bound sliding
vgy = vg(2);

f = [txi; tyi; tti; vxi; vyi; vti; dwl; dwr; vgy;]
w = jacobian(f, [txf, tyf, ttf, vxf, vyf, vtf, axf, ayf, atf])
